<mxfile host="app.diagrams.net" agent="NEA Analysis" version="24.0.0">
  <diagram name="Wilson Score Calculator DFD" id="wilson-dfd">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="t1" value="Data Flow Diagram: Wilson Score Confidence Interval Calculator" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="550" height="40" as="geometry" />
        </mxCell>

        <!-- External Entity: User -->
        <mxCell id="e1" value="User" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- External Entity: Reports View -->
        <mxCell id="e2" value="Reports View&#xa;(UI Layer)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Process 1.0: Calculate For All Contacts -->
        <mxCell id="p1" value="1.0&#xa;calculateForAllContacts()&#xa;(Orchestrate Calculation&#xa;per Contact)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="100" width="230" height="120" as="geometry" />
        </mxCell>

        <!-- Process 2.0: Group Calls by Phone -->
        <mxCell id="p2" value="2.0&#xa;Group Calls&#xa;by Normalised Phone&#xa;(Aggregate per Contact)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="300" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- Process 3.0: Was Call Answered -->
        <mxCell id="p3" value="3.0&#xa;_wasCallAnswered()&#xa;(Count Successes)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="450" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Process 4.0: Calculate Wilson Score -->
        <mxCell id="p4" value="4.0&#xa;calculateWilsonScore()&#xa;CI = (p + z²/2n ± z√(p(1-p)/n&#xa;+ z²/4n²)) / (1 + z²/n)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="150" width="260" height="130" as="geometry" />
        </mxCell>

        <!-- Process 5.0: Confidence Score -->
        <mxCell id="p5" value="5.0&#xa;Confidence Score&#xa;((1 - intervalWidth) × 100)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="350" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Process 6.0: Sort Results -->
        <mxCell id="p6" value="6.0&#xa;Sort by&#xa;Confidence Score&#xa;(Descending)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="150" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- Data Store: Contact Directories -->
        <mxCell id="d1" value="D1 | Firestore 'Contact Directories' Collection" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- Data Store: call_history -->
        <mxCell id="d2" value="D2 | Firestore 'call_history' Collection" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- Data Store: WilsonScoreResult -->
        <mxCell id="d3" value="D3 | WilsonScoreResult (successRate, lowerBound, upperBound, confidenceScore)" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="920" y="350" width="370" height="40" as="geometry" />
        </mxCell>

        <!-- Flows -->
        <mxCell id="f1" value="View contact&#xa;confidence scores" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="e1" target="e2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f2" value="userId" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="e2" target="p1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Orchestrate -> Group Calls -->
        <mxCell id="f3" value="All contacts &amp;&#xa;call records" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p1" target="p2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Orchestrate -> Contact Directories -->
        <mxCell id="f4" value="Query contacts" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p1" target="d1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="240" y="160" />
              <mxPoint x="240" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Orchestrate -> call_history -->
        <mxCell id="f5" value="Query call history" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p1" target="d2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="230" y="200" />
              <mxPoint x="230" y="570" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Group -> Was Answered -->
        <mxCell id="f6" value="Each call record" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p2" target="p3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Group -> Wilson Score -->
        <mxCell id="f7" value="totalCalls,&#xa;successfulCalls&#xa;per contact" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p2" target="p4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Wilson Score -> Confidence Score -->
        <mxCell id="f8" value="p̂, lowerBound,&#xa;upperBound,&#xa;intervalWidth" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p4" target="p5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Wilson Score -> Sort -->
        <mxCell id="f9" value="WilsonScoreResult&#xa;per contact" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p4" target="p6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Sort -> Result Store -->
        <mxCell id="f10" value="Sorted results&#xa;(most confident first)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p6" target="d3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Result -> UI -->
        <mxCell id="f11" value="List&lt;WilsonScoreResult&gt;&#xa;(confidence scores,&#xa;interval bounds)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;dashed=1;" edge="1" source="d3" target="e2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1105" y="410" />
              <mxPoint x="1105" y="500" />
              <mxPoint x="1300" y="500" />
              <mxPoint x="1300" y="630" />
              <mxPoint x="100" y="630" />
              <mxPoint x="100" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
