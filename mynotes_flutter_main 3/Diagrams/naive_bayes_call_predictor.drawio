<mxfile host="app.diagrams.net" agent="NEA Analysis" version="24.0.0">
  <diagram name="Naive Bayes Call Predictor DFD" id="naive-bayes-dfd">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="t1" value="Data Flow Diagram: Naive Bayes Call Predictor" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="450" height="40" as="geometry" />
        </mxCell>

        <!-- External Entity: User -->
        <mxCell id="e1" value="User" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- External Entity: Contact Prediction View -->
        <mxCell id="e2" value="Call Prediction&#xa;View (UI)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Process 1.0: Fetch Call History -->
        <mxCell id="p1" value="1.0&#xa;_fetchCallHistory()&#xa;(Retrieve &amp; Filter&#xa;by Phone Number)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- Process 2.0: Normalise Phone -->
        <mxCell id="p2" value="2.0&#xa;_normalizePhone()&#xa;(Last 9 Digits)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="240" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Process 3.0: Was Call Answered -->
        <mxCell id="p3" value="3.0&#xa;_wasCallAnswered()&#xa;(Classify Call&#xa;Outcome)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="370" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- Process 4.0: Predict Best Times -->
        <mxCell id="p4" value="4.0&#xa;predictBestTimes()&#xa;(Naive Bayes with&#xa;Laplace Smoothing)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="150" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Process 5.0: Current Time Recommendation -->
        <mxCell id="p5" value="5.0&#xa;getCurrentTimeRecommendation()&#xa;(Compare Current Slot&#xa;vs Average)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="340" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- Process 6.0: Group by Day -->
        <mxCell id="p6" value="6.0&#xa;getPredictionsByDay()&#xa;(Day-of-Week&#xa;Breakdown)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="80" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Data Store: call_history -->
        <mxCell id="d1" value="D1 | Firestore 'call_history' Collection" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="530" width="280" height="40" as="geometry" />
        </mxCell>

        <!-- Data Store: Frequency Table -->
        <mxCell id="d2" value="D2 | Frequency Table (day-hour → total, answered)" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="620" y="530" width="330" height="40" as="geometry" />
        </mxCell>

        <!-- Data Store: CallPrediction Objects -->
        <mxCell id="d3" value="D3 | CallPrediction Objects (day, hour, probability)" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="930" y="260" width="310" height="40" as="geometry" />
        </mxCell>

        <!-- Flows -->
        <!-- User -> UI -->
        <mxCell id="f1" value="Select contact,&#xa;request prediction" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="e1" target="e2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- UI -> Fetch History -->
        <mxCell id="f2" value="userId,&#xa;phoneNumber" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="e2" target="p1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Fetch History -> Firestore -->
        <mxCell id="f3" value="Query by user_id" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p1" target="d1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Firestore -> Fetch History (return) -->
        <mxCell id="f4" value="Call records&#xa;(address, timestamp,&#xa;answered, call_type)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;dashed=1;" edge="1" source="d1" target="p1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="550" />
              <mxPoint x="550" y="135" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Fetch -> Normalise Phone -->
        <mxCell id="f5" value="Raw phone&#xa;number" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p1" target="p2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Fetch -> Was Call Answered -->
        <mxCell id="f6" value="Call data record" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p1" target="p3" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="280" y="135" />
              <mxPoint x="280" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Fetch -> Predict Best Times -->
        <mxCell id="f7" value="Filtered call data&#xa;{day_of_week, hour,&#xa;answered}" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p1" target="p4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Predict -> Frequency Table -->
        <mxCell id="f8" value="Build frequency table&#xa;(count by day-hour)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p4" target="d2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Frequency Table -> Predict (Bayes formula) -->
        <mxCell id="f9" value="P(answered|day,hour) =&#xa;(answered+1) / (total+2)&#xa;(Laplace smoothing)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;dashed=1;" edge="1" source="d2" target="p4" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="550" />
              <mxPoint x="600" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Predict -> CallPrediction Objects -->
        <mxCell id="f10" value="Sorted predictions&#xa;(highest probability first)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p4" target="d3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CallPrediction -> Current Time Rec -->
        <mxCell id="f11" value="All predictions" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="d3" target="p5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CallPrediction -> Group by Day -->
        <mxCell id="f12" value="All predictions" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="d3" target="p6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Current Time Rec -> UI -->
        <mxCell id="f13" value="should_call_now,&#xa;current_probability,&#xa;reason" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;dashed=1;" edge="1" source="p5" target="e2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="460" />
              <mxPoint x="200" y="460" />
              <mxPoint x="200" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Group by Day -> UI -->
        <mxCell id="f14" value="Map&lt;day, predictions&gt;&#xa;(per-day breakdown)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;dashed=1;" edge="1" source="p6" target="e2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1060" y="60" />
              <mxPoint x="210" y="60" />
              <mxPoint x="210" y="100" />
