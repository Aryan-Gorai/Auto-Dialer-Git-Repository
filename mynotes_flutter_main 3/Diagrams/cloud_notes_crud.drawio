        <!-- Process 1.0: FirebaseCloudStorage (Singleton) -->
        <mxCell id="p1" value="1.0&#xa;FirebaseCloudStorage&#xa;(Singleton Service)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="200" width="220" height="120" as="geometry" />
