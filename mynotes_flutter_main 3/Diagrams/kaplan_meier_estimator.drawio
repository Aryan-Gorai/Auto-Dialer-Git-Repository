        <!-- KMResult -> UI -->
        <mxCell id="f14" value="KaplanMeierResult&#xa;(curve, median,&#xa;conversion probs)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;dashed=1;" edge="1" source="d5" target="e2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1280" y="360" />
