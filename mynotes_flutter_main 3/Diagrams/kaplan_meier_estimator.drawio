<mxfile host="app.diagrams.net" agent="NEA Analysis" version="24.0.0">
  <diagram name="Kaplan-Meier Estimator DFD" id="kaplan-meier-dfd">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="t1" value="Data Flow Diagram: Kaplan-Meier Estimator (Survival Analysis)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="550" height="40" as="geometry" />
        </mxCell>

        <!-- External Entity: User -->
        <mxCell id="e1" value="User" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- External Entity: Reports View -->
        <mxCell id="e2" value="Reports View&#xa;(UI Layer)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Process 1.0: Analyse -->
        <mxCell id="p1" value="1.0&#xa;analyse()&#xa;(Orchestrate&#xa;Survival Analysis)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="100" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- Process 2.0: Collect Lead Data -->
        <mxCell id="p2" value="2.0&#xa;_collectLeadConversionData()&#xa;(Fetch &amp; Process&#xa;Per-Contact Data)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="300" width="230" height="120" as="geometry" />
        </mxCell>

        <!-- Process 3.0: Calculate KM -->
        <mxCell id="p3" value="3.0&#xa;_calculateKaplanMeier()&#xa;S(t) = Π(1 - dᵢ/nᵢ)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="100" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- Process 4.0: Find Median -->
        <mxCell id="p4" value="4.0&#xa;_findMedianTime()&#xa;(S(t) ≤ 0.5)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="260" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Process 5.0: Key Time Probabilities -->
        <mxCell id="p5" value="5.0&#xa;_getConversionProbabilities&#xa;AtKeyTimes()&#xa;(1, 3, 7, 14, 30 days)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="390" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- Process 6.0: Was Call Answered -->
        <mxCell id="p6" value="6.0&#xa;_wasCallAnswered()&#xa;(Classify Conversion)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="480" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Data Store: Contact Directories -->
        <mxCell id="d1" value="D1 | Firestore 'Contact Directories' Collection" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- Data Store: call_history -->
        <mxCell id="d2" value="D2 | Firestore 'call_history' Collection" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- Data Store: LeadConversionData -->
        <mxCell id="d3" value="D3 | LeadConversionData (firstContact, conversionDate, daysToConversion)" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="540" width="360" height="40" as="geometry" />
        </mxCell>

        <!-- Data Store: SurvivalDataPoint -->
        <mxCell id="d4" value="D4 | SurvivalDataPoint (timeInDays, atRisk, events, survivalProb)" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="930" y="140" width="340" height="40" as="geometry" />
        </mxCell>

        <!-- Data Store: KaplanMeierResult -->
        <mxCell id="d5" value="D5 | KaplanMeierResult (survivalCurve, medianTime, conversionProbabilities)" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="930" y="340" width="370" height="40" as="geometry" />
        </mxCell>

        <!-- Flows -->
        <mxCell id="f1" value="Request survival&#xa;analysis" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="e1" target="e2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f2" value="userId" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="e2" target="p1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Analyse -> Collect -->
        <mxCell id="f3" value="userId" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p1" target="p2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Collect -> Contact Directories -->
        <mxCell id="f4" value="Query contacts&#xa;by user_id" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p2" target="d1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Collect -> call_history -->
        <mxCell id="f5" value="Query all calls&#xa;by user_id" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p2" target="d2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Collect -> Was Answered -->
        <mxCell id="f6" value="Call data record" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p2" target="p6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Collect -> LeadConversionData -->
        <mxCell id="f7" value="First contact date,&#xa;conversion date,&#xa;days to conversion" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p2" target="d3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LeadConversionData -> Calculate KM -->
        <mxCell id="f8" value="List&lt;LeadConversionData&gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="d3" target="p3" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="560" />
              <mxPoint x="740" y="520" />
              <mxPoint x="900" y="520" />
              <mxPoint x="900" y="60" />
              <mxPoint x="730" y="60" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Calculate KM -> SurvivalDataPoint -->
        <mxCell id="f9" value="Survival curve&#xa;data points" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p3" target="d4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SurvivalDataPoint -> Find Median -->
        <mxCell id="f10" value="Survival curve" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="d4" target="p4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SurvivalDataPoint -> Key Times -->
        <mxCell id="f11" value="Survival curve" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="d4" target="p5" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1100" y="200" />
              <mxPoint x="1100" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Find Median + Key Times -> KMResult -->
        <mxCell id="f12" value="medianTime,&#xa;probabilities" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p4" target="d5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f13" value="Probabilities at&#xa;1, 3, 7, 14, 30 days" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p5" target="d5" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="850" y="440" />
              <mxPoint x="850" y="360" />
            </Array>
          </mxGeometry>
