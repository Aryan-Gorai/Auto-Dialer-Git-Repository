        </mxCell>

        <!-- Process 2.0: Train Model -->
        <mxCell id="p2" value="2.0&#xa;trainModel()&#xa;(Least Squares Method&#xa;β = (XᵀX)⁻¹Xᵀy)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="220" height="120" as="geometry" />
        </mxCell>

