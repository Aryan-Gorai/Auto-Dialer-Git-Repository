        <mxCell id="p3" value="3.0&#xa;Matrix Operations&#xa;(_transpose, _matrixMultiply,&#xa;_matrixInverse,&#xa;_matrixVectorMultiply)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="950" y="80" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Process 4.0: Predict -->
