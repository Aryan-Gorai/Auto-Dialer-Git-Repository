<mxfile host="app.diagrams.net" agent="NEA Analysis" version="24.0.0">
  <diagram name="Call Cycle Service DFD" id="call-cycle-dfd">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="t1" value="Data Flow Diagram: Call Cycle Service" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- External Entity: User -->
        <mxCell id="e1" value="User" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- External Entity: List View UI -->
        <mxCell id="e2" value="List View&#xa;(UI Layer)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Process 1.0: Start Cycle -->
        <mxCell id="p1" value="1.0&#xa;startCycle()&#xa;(Initiate List Cycle)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Process 2.0: Record Call Dialog -->
        <mxCell id="p2" value="2.0&#xa;recordCallDialogShown()&#xa;(Log Intent)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Process 3.0: Record Dial/Cancel -->
        <mxCell id="p3" value="3.0&#xa;recordDialPressed() /&#xa;recordDialCancelled()&#xa;(Update Intent)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="370" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- Process 4.0: End Cycle -->
        <mxCell id="p4" value="4.0&#xa;endCycle()&#xa;(Complete Cycle)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="530" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Process 5.0: Reconcile Cycle -->
        <mxCell id="p5" value="5.0&#xa;reconcileCycle()&#xa;(Match Intents to Calls)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="300" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Process 6.0: Scoring -->
        <mxCell id="p6" value="6.0&#xa;Match Scoring&#xa;(_timeScore, _orderScore,&#xa;_directionScore)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="300" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Process 7.0: Recompute Aggregates -->
        <mxCell id="p7" value="7.0&#xa;_recomputeCycleAggregates()&#xa;(Update Statistics)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="500" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- Data Store: list_cycles -->
        <mxCell id="d1" value="D1 | Firestore 'list_cycles' Collection" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="280" height="40" as="geometry" />
        </mxCell>

        <!-- Data Store: cycle_events -->
        <mxCell id="d2" value="D2 | Firestore 'cycle_events' Subcollection" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="620" y="170" width="300" height="40" as="geometry" />
