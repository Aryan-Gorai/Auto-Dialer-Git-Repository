        <mxCell id="f4" value="cycleId, eventId,&#xa;user action" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="e2" target="p3" parent="1">
