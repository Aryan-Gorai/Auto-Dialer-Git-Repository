          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Recompute -> list_cycles -->
        <mxCell id="f14" value="Updated stats&#xa;(duration, outgoing,&#xa;missed, cancelled)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p7" target="d4" parent="1">
          <mxGeometry relative="1" as="geometry" />
