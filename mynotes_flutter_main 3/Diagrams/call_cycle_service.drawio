          </mxGeometry>
        </mxCell>

        <mxCell id="f8" value="completedContacts,&#xa;completion_pct" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p4" target="d1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="570" y="580" />
              <mxPoint x="570" y="100" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Reconcile reads intents and call history -->
        <mxCell id="f9" value="Unmatched intents&#xa;(action=dialed)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="d2" target="p5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f10" value="Unlinked call&#xa;history records" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="d3" target="p5" parent="1">
          <mxGeometry relative="1" as="geometry" />
