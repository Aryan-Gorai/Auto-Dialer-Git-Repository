          <mxGeometry x="1050" y="170" width="280" height="40" as="geometry" />
        </mxCell>

        <!-- Data Store: lists_collection -->
        <mxCell id="d4" value="D4 | Firestore 'lists_collection'" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="620" y="680" width="280" height="40" as="geometry" />
        </mxCell>

        <!-- Flows -->
        <mxCell id="f1" value="Start/stop cycle,&#xa;dial/cancel contact" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="e1" target="e2" parent="1">
          <mxGeometry relative="1" as="geometry" />
