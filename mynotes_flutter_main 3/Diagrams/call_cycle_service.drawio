        <mxCell id="f3" value="contactDocId,&#xa;contactName, phone" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="e2" target="p2" parent="1">
