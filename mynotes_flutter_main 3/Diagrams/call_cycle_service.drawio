        <!-- Reconcile -> Scoring -->
        <mxCell id="f11" value="Phone, time,&#xa;order, direction" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" source="p5" target="p6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Scoring -> Reconcile (match score) -->
        <mxCell id="f12" value="match_score&#xa;(weighted composite)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;dashed=1;" edge="1" source="p6" target="p5" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1160" y="440" />
              <mxPoint x="810" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Reconcile -> Recompute -->
