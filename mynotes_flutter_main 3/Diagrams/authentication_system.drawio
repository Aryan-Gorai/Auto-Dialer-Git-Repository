          <mxGeometry x="620" y="270" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- Process 3.0: FirebaseAuthProvider -->
        <mxCell id="5" value="3.0&#xa;FirebaseAuthProvider&#xa;(Provider Layer)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="270" width="200" height="120" as="geometry" />
        </mxCell>

        <!-- Data Store: Firebase Auth -->
        <mxCell id="6" value="D1 | Firebase Authentication" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="870" y="520" width="280" height="40" as="geometry" />
        </mxCell>

        <!-- Data Store: AuthState -->
        <mxCell id="7" value="D2 | Auth State (BLoC)" style="shape=partialRectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;top=1;left=0;right=0;bottom=0;" vertex="1" parent="1">
          <mxGeometry x="280" y="520" width="220" height="40" as="geometry" />
        </mxCell>

        <!-- External Entity: Flutter UI -->
        <mxCell id="8" value="Flutter UI&#xa;(Widget Tree)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Process 4.0: AuthUser Model -->
        <mxCell id="9" value="4.0&#xa;AuthUser Model&#xa;(Data Mapping)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="80" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- Process 5.0: Exception Handling -->
        <mxCell id="10" value="5.0&#xa;Auth Exception&#xa;Handler" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="480" width="160" height="100" as="geometry" />
        </mxCell>

        <!-- Data Flows -->
        <!-- User -> AuthBloc: AuthEvents -->
        <mxCell id="11" value="AuthEvent (LogIn,&#xa;Register, LogOut)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="2" target="3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- AuthBloc -> AuthService -->
        <mxCell id="12" value="createUser(), logIn(),&#xa;logOut(), sendEmailVerification()" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="3" target="4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- AuthService -> FirebaseAuthProvider -->
        <mxCell id="13" value="Delegates all&#xa;auth operations" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="4" target="5" parent="1">
          <mxGeometry relative="1" as="geometry" />
