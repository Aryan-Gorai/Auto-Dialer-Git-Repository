          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FirebaseAuthProvider -> Exception Handler -->
        <mxCell id="20" value="FirebaseAuthException&#xa;(error codes)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="5" target="10" parent="1">
