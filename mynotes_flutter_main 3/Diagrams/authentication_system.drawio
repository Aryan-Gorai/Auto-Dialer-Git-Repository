<mxfile host="app.diagrams.net" agent="NEA Analysis" version="24.0.0">
  <diagram name="Authentication System DFD" id="auth-dfd">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- External Entity: User -->
        <mxCell id="2" value="User" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Process 1.0: AuthBloc -->
        <mxCell id="3" value="1.0&#xa;AuthBloc&#xa;(Business Logic)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="270" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- Process 2.0: AuthService -->
